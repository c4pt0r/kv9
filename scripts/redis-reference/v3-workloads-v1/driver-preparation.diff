+            fragment_bytes=value.f_frsize, blocks=value.f_blocks, free_blocks=value.f_bfree,
+            available_blocks=value.f_bavail, available_bytes=value.f_bavail * value.f_frsize)
+    result["completed_unix_ns"] = time.time_ns()
