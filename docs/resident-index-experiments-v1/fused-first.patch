+    /// Insert a cloned key/value in one traversal, or reuse an existing value.
+    /// The existing key is retained when it compares equal. Mutable access uses
+    /// structural copy-on-write, so owned map clones retain their old values.
+    pub fn insert_cloned_mut(&mut self, key: &K, value: &V) {
+        if Node::insert_cloned(&mut self.root, key, value) {
+            self.size += 1;
+        }
+    }
