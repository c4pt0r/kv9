; A successful sampled leader check implies every granting voter still holds.
; Each elapsed sample has independent signed error at most 2*epsilon.
(set-logic QF_NRA)
(declare-const a Real)
(declare-const b Real)
(declare-const epsilon Real)
(declare-const s Real)
(declare-const g Real)
(declare-const t Real)
(declare-const E Real)
(declare-const D Real)
(declare-const leader_elapsed Real)
(declare-const voter_elapsed Real)
(assert (and (> a 0) (<= a b) (>= epsilon 0) (> E 0) (> D 0)))
(assert (and (<= s g) (<= g t)))
(assert (<= (* (+ D (* 2 epsilon)) b) (* (- E (* 2 epsilon)) a)))
(assert (>= leader_elapsed (- (* a (- t s)) (* 2 epsilon))))
(assert (< leader_elapsed D))
(assert (<= voter_elapsed (+ (* b (- t g)) (* 2 epsilon))))
(assert (>= voter_elapsed E))
(check-sat)
