; A new incarnation cannot leave quarantine while a prior promise may be live.
(set-logic QF_NRA)
(declare-const a Real)
(declare-const b Real)
(declare-const epsilon Real)
(declare-const g Real)
(declare-const r Real)
(declare-const t Real)
(declare-const E Real)
(declare-const R Real)
(declare-const old_elapsed Real)
(declare-const recovered_elapsed Real)
(assert (and (> a 0) (<= a b) (>= epsilon 0) (> E 0) (> R 0)))
(assert (and (<= g r) (<= r t)))
(assert (>= (* (- R (* 2 epsilon)) a) (* (+ E (* 2 epsilon)) b)))
(assert (>= old_elapsed (- (* a (- t g)) (* 2 epsilon))))
(assert (< old_elapsed E))
(assert (<= recovered_elapsed (+ (* b (- t r)) (* 2 epsilon))))
(assert (>= recovered_elapsed R))
(check-sat)
