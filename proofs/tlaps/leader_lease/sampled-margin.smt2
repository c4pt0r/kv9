; The shared recovery margin also covers leader containment, with safe rounding.
(set-logic QF_NRA)
(declare-const a Real)
(declare-const b Real)
(declare-const epsilon Real)
(declare-const E Real)
(declare-const D Real)
(declare-const R Real)
(declare-const M Real)
(assert (and (> a 0) (<= a b) (>= epsilon 0) (> E 0) (> D 0) (> R 0) (>= M 0)))
(assert (>= (* M a) (* 2 epsilon (+ a b))))
(assert (<= (* (+ D M) b) (* E a)))
(assert (>= (* (- R M) a) (* E b)))
(assert (or (> (* (+ D (* 2 epsilon)) b) (* (- E (* 2 epsilon)) a))
            (< (* (- R (* 2 epsilon)) a) (* (+ E (* 2 epsilon)) b))))
(check-sat)
