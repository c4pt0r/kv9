  "lean_sha256": "e8baaa71855a616dc351028f3ad2200051b0671f423a1696a100e809302d5550",
  "controls": [
    {
      "name": "leaf-prefix-too-long",
      "module": "InsertSplits.lean",
      "old": "leafSplitBytes ((old.key.drop depth).take sharedLength)",
      "new": "leafSplitBytes ((old.key.drop depth).take (sharedLength + 1))",
      "kind": "semantic"
    },
    {
      "name": "leaf-new-byte-offset",
      "module": "InsertSplits.lean",
      "old": "old fresh old.key[cut]? fresh.key[cut]?",
      "new": "old fresh old.key[cut]? fresh.key[cut + 1]?",
      "kind": "semantic"
    },
    {
      "name": "leaf-wrong-terminal",
      "module": "InsertSplits.lean",
      "old": "| none, some byte => some (.branch pfx (some old)",
      "new": "| none, some byte => some (.branch pfx (some fresh)",
      "kind": "semantic"
    },
    {
      "name": "branch-keeps-edge-byte",
      "module": "InsertSplits.lean",
      "old": "let oldChild := Tree.branch (pfx.drop (sharedLength + 1))",
      "new": "let oldChild := Tree.branch (pfx.drop sharedLength)",
      "kind": "semantic"
    },
    {
      "name": "branch-prefix-too-long",
      "module": "InsertSplits.lean",
      "old": "| none => some (.branch (pfx.take sharedLength) (some fresh)",
      "new": "| none => some (.branch (pfx.take (sharedLength + 1)) (some fresh)",
      "kind": "semantic"
    },
    {
      "name": "replace-selects-split",
      "module": "InsertStep.lean",
      "old": "if old.key = fresh.key then some .replaceLeaf",
      "new": "if old.key = fresh.key then some (.splitLeaf 0)",
      "kind": "semantic"
    },
    {
      "name": "split-at-full-prefix",
      "module": "InsertStep.lean",
      "old": "if sharedLength < pfx.length then some (.splitBranch sharedLength)",
      "new": "if sharedLength <= pfx.length then some (.splitBranch sharedLength)",
      "kind": "semantic"
    },
    {
      "name": "descent-skips-byte",
      "module": "InsertStep.lean",
      "old": "some (.descend index (depth + sharedLength + 1))",
      "new": "some (.descend index (depth + sharedLength + 2))",
      "kind": "semantic"
    },
    {
      "name": "replace-keeps-old-value",
      "module": "InsertStep.lean",
      "old": "| .leaf _ => .done (.leaf fresh) false",
      "new": "| .leaf old => .done (.leaf old) false",
      "kind": "semantic"
    },
    {
      "name": "terminal-always-inserted",
      "module": "InsertStep.lean",
      "old": "| .branch pfx terminal children => .done (.branch pfx (some fresh) children) terminal.isNone",
      "new": "| .branch pfx _ children => .done (.branch pfx (some fresh) children) true",
      "kind": "semantic"
    },
    {
      "name": "edge-wrong-insertion-index",
      "module": "InsertStep.lean",
      "old": "(.branch pfx terminal (edgeInsert index byte (.leaf fresh) children)) true",
      "new": "(.branch pfx terminal (edgeInsert (index + 1) byte (.leaf fresh) children)) true",
      "kind": "semantic"
    },
    {
      "name": "mutable-slot-wrong-index",
      "module": "InsertStep.lean",
