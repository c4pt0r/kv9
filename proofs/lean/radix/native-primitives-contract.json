  "controls": [
    {
      "name": "entry-address-omits-field-offset",
      "module": "NativeEntryStorage.lean",
      "old": "some (block.base + image.entryOffset address)",
      "new": "some block.base",
      "kind": "semantic"
    },
    {
      "name": "branch-entry-uses-arc-payload",
      "module": "NativeEntryStorage.lean",
      "old": "| .branch _ _ _ => .branchBox",
      "new": "| .branch _ _ _ => .arcNode",
      "kind": "semantic"
    },
    {
      "name": "zero-sized-entry-layout",
      "module": "NativeObjectHeap.lean",
      "old": "0 < layout.entryBytes \u2227",
      "new": "0 \u2264 layout.entryBytes \u2227",
      "kind": "semantic"
    },
    {
      "name": "overwrite-all-object-owners",
      "module": "NativeObjectUpdate.lean",
      "old": "if owner.node = focus then",
      "new": "if True then",
      "kind": "semantic"
    },
    {
      "name": "leaf-retains-branch-box",
      "module": "NativeObjectPayload.lean",
      "old": "| .branchBox => none",
      "new": "| .branchBox => some arc",
      "kind": "semantic"
    },
    {
      "name": "reclaim-clears-surviving-object",
      "module": "NativeObjectReclaim.lean",
      "old": "| some _ => blocks owner",
      "new": "| some _ => none",
      "kind": "semantic"
    },
    {
      "name": "reclaim-keeps-dead-object",
      "module": "NativeObjectReclaim.lean",
      "old": "| none => none",
      "new": "| none => blocks owner",
      "kind": "semantic"
    },
    {
      "name": "copy-skips-old-release",
      "module": "NativeCowCopy.lean",
      "old": "let next \u2190 assignRoot (heapAlloc heap node) focus heap.length others",
      "new": "let next \u2190 some (heapAlloc heap node)",
      "kind": "semantic"
    },
    {
      "name": "copy-returns-old-identity",
      "module": "NativeCowCopy.lean",
      "old": "  some (next, heap.length)\n",
      "new": "  some (next, focus)\n",
      "kind": "semantic"
    },
    {
      "name": "copy-loses-child-token",
      "module": "NativeCowInterleave.lean",
      "old": "\u27e8pool, child :: retained, remaining\u27e9",
      "new": "\u27e8pool, retained, remaining\u27e9",
      "kind": "semantic"
    },
    {
      "name": "copy-release-does-not-hold-source",
      "module": "NativeCowInterleave.lean",
      "old": "(step : PoolRelease (retained ++ focus :: saved) first next)",
      "new": "(step : PoolRelease (retained ++ saved) first next)",
      "kind": "semantic"
    },
    {
      "name": "copy-begins-without-child-work",
      "module": "NativeCowInterleave.lean",
      "old": "\u27e8pool, [], (storedChildren node).map Prod.snd\u27e9 :=",
      "new": "\u27e8pool, [], []\u27e9 :=",
      "kind": "semantic"
    },
    {
      "name": "assignment-duplicates-old-token",
      "module": "NativeCowFinish.lean",
      "old": "\u27e8heap, [focus] :: workers\u27e9",
      "new": "\u27e8heap, [focus, focus] :: workers\u27e9",
      "kind": "semantic"
    },
    {
      "name": "assignment-loses-old-token",
      "module": "NativeCowFinish.lean",
      "old": "\u27e8heap, [focus] :: workers\u27e9",
      "new": "\u27e8heap, workers\u27e9",
      "kind": "semantic"
    },
    {
      "name": "proof-hole",
      "module": "NativeCowExamples.lean",
      "old": "by\n  intro valid\n  have wrong : ([2] : List NodeId) = [1, 2] := valid.progress\n  cases wrong",
      "new": "by\n  sorry",
      "kind": "hole"
    },
    {
      "name": "custom-false-axiom",
      "module": "NativeCowExamples.lean",
      "old": "by\n  intro valid\n  have wrong : ([2] : List NodeId) = [1, 2] := valid.progress\n  cases wrong",
      "new": "by\n  exact False.elim injectedNativeFalse",
      "kind": "axiom"
    }
