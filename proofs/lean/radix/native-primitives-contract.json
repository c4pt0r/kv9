    {
      "name": "rust-enables-unsafe-bypass",
      "old": "#![forbid(unsafe_code)]",
      "new": "#![allow(unsafe_code)]"
    },
    {
      "name": "rust-skips-make-mut",
      "old": "match Arc::make_mut(node) {",
      "new": "match Arc::get_mut(node).unwrap() {"
