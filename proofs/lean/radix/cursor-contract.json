  "controls": [
    {
      "name": "forward-omits-terminal",
      "module": "CursorTraversal.lean",
      "old": "else terminalTasks terminal ++ forestTasks children",
      "new": "else forestTasks children",
      "kind": "semantic"
    },
    {
      "name": "reverse-child-order",
      "module": "CursorTraversal.lean",
      "old": "if reverse then (forestTasks children).reverse ++ terminalTasks terminal",
      "new": "if reverse then forestTasks children ++ terminalTasks terminal",
      "kind": "semantic"
    },
    {
      "name": "forward-duplicates-terminal",
      "module": "CursorTraversal.lean",
      "old": "else terminalTasks terminal ++ forestTasks children",
      "new": "else terminalTasks terminal ++ terminalTasks terminal ++ forestTasks children",
      "kind": "semantic"
    },
    {
      "name": "yield-discards-pending",
      "module": "CursorTraversal.lean",
      "old": "| .entry entry :: tail => some (entry, tail)",
      "new": "| .entry entry :: _ => some (entry, [])",
      "kind": "semantic"
    },
    {
      "name": "expansion-discards-ancestors",
      "module": "CursorTraversal.lean",
      "old": "| .node (.branch _ terminal children) :: tail => nextTask reverse (branchTasks reverse terminal children ++ tail)",
      "new": "| .node (.branch _ terminal children) :: _ => nextTask reverse (branchTasks reverse terminal children)",
      "kind": "semantic"
    },
    {
      "name": "mismatch-prunes-wrong-side",
      "module": "CursorSeek.lean",
      "old": "if mismatchGreater pfx suffix != reverse then",
      "new": "if mismatchGreater pfx suffix == reverse then",
      "kind": "semantic"
    },
    {
      "name": "exclusive-end-includes-terminal",
      "module": "CursorSeek.lean",
      "old": "(if inclusive then terminalTasks terminal else []) ++",
      "new": "(if inclusive then terminalTasks terminal else terminalTasks terminal) ++",
      "kind": "semantic"
    },
    {
      "name": "reverse-end-includes-descendants",
      "module": "CursorSeek.lean",
      "old": "(if reverse then [] else forestTasks children)",
      "new": "(if reverse then forestTasks children else forestTasks children)",
      "kind": "semantic"
    },
    {
      "name": "forward-match-skips-tail",
      "module": "CursorSeek.lean",
      "old": "seekTree (path ++ [byte]) query inclusive reverse child ++ (if reverse then [] else forestTasks tail)",
      "new": "seekTree (path ++ [byte]) query inclusive reverse child ++ (if reverse then [] else [])",
      "kind": "semantic"
    },
    {
      "name": "reverse-skips-earlier-child",
      "module": "CursorSeek.lean",
      "old": "seekForest path query inclusive reverse tail target ++ (if reverse then [.node child] else [])",
      "new": "seekForest path query inclusive reverse tail target ++ (if reverse then [] else [])",
      "kind": "semantic"
    },
    {
      "name": "reverse-skips-branch-terminal",
      "module": "CursorSeek.lean",
      "old": "(if reverse then terminalTasks terminal else [])",
      "new": "(if reverse then [] else [])",
      "kind": "semantic"
    },
    {
      "name": "missing-edge-wrong-side",
      "module": "CursorSeek.lean",
      "old": "else if target < byte then",
      "new": "else if byte < target then",
      "kind": "semantic"
    },
    {
      "name": "crossed-range-emits",
      "module": "RangeStep.lean",
      "old": "if last.key < first.key then (none, clearRange state)",
      "new": "if last.key < first.key then (some first, clearRange state)",
      "kind": "semantic"
    },
    {
      "name": "equal-endpoint-stays-live",
      "module": "RangeStep.lean",
      "old": "(some (if reverse then last else first), clearRange state)",
      "new": "(some (if reverse then last else first), state)",
      "kind": "semantic"
    },
    {
      "name": "front-advances-back-cursor",
      "module": "RangeStep.lean",
      "old": "else (some first, \u27e8loadCursor false state.front.pending, state.back\u27e9)",
      "new": "else (some first, \u27e8loadCursor false state.back.pending, state.back\u27e9)",
      "kind": "semantic"
    },
    {
      "name": "back-emits-front",
      "module": "RangeStep.lean",
      "old": "(some last, \u27e8state.front, loadCursor true state.back.pending\u27e9)",
      "new": "(some first, \u27e8state.front, loadCursor true state.back.pending\u27e9)",
      "kind": "semantic"
    },
    {
      "name": "invalid-bounds-accepted",
      "module": "RangeInit.lean",
      "old": "if ValidRangeBounds lower upper then some (initRange root lower upper) else none",
      "new": "if True then some (initRange root lower upper) else none",
      "kind": "semantic"
    },
    {
      "name": "equal-inclusive-bounds-rejected",
      "module": "RangeInit.lean",
      "old": "lo \u2264 hi \u2227 (lo \u2260 hi \u2228 loInclusive = true \u2228 hiInclusive = true)",
