      "kind": "semantic"
    },
    {
      "name": "predecessor-excludes-equal",
      "module": "RangeProperties.lean",
      "old": "(loadCursor true (seekRoot root (some (query, true)) true)).current",
      "new": "(loadCursor true (seekRoot root (some (query, false)) true)).current",
      "kind": "semantic"
    },
    {
      "name": "cursor-proof-hole",
